DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_IDENTITY_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_YOUTUBE_REDIRECT_URI=http://localhost:8000/auth/youtube/callback
TOKEN_ENCRYPTION_KEY=
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
SESSION_COOKIE_SAMESITE=lax

# Provider requests remain bounded.
PROVIDER_TIMEOUT_SECONDS=15
PROVIDER_READ_RETRIES=2

# Realtime statistics collector. Keep enabled for local development and for
# exactly one persistent production API process. Disable it on any additional
# API replicas to avoid duplicate YouTube polling.
REALTIME_COLLECTOR_ENABLED=true

# Production test access gate. Keep private_test until a deliberate public launch.
DEPLOYMENT_ACCESS_MODE=private_test
ALLOWED_LOGIN_EMAILS=

# Production with the Vercel first-party proxy uses:
# FRONTEND_ORIGIN=https://YOUR-VERCEL-SITE
# GOOGLE_IDENTITY_REDIRECT_URI=https://YOUR-VERCEL-SITE/api/auth/google/callback
# GOOGLE_YOUTUBE_REDIRECT_URI=https://YOUR-VERCEL-SITE/api/auth/youtube/callback
# SESSION_COOKIE_SAMESITE=lax
#
# Use a separate test DATABASE_URL rather than the local/development database.
