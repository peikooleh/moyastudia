DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_IDENTITY_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_YOUTUBE_REDIRECT_URI=http://localhost:8000/auth/youtube/callback
TOKEN_ENCRYPTION_KEY=
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# For cross-site test hosting (e.g. Vercel frontend + separate API host),
# set SESSION_COOKIE_SAMESITE=none; HTTPS + Secure cookies are mandatory.
# Use lax when frontend and API are on the same site.
SESSION_COOKIE_SAMESITE=lax

# Provider requests remain bounded. Keep one API worker/instance for the first test deployment.
PROVIDER_TIMEOUT_SECONDS=15
PROVIDER_READ_RETRIES=2
