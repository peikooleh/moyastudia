# Local development: browser talks directly to the local FastAPI server.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Vercel production:
# NEXT_PUBLIC_API_URL=/api
# API_UPSTREAM_URL=https://YOUR-FASTAPI-HOST
#
# /api/* is rewritten server-side by Next.js to API_UPSTREAM_URL/*.
# This keeps the session cookie first-party on the Vercel site.
# Use npm run build:deployment as the Vercel Build Command.
